#!/bin/bash
# s6 longrun: manage PulseAudio remap-sink topology for multi-channel cards.
# Creates zone sinks on startup and reacts to physical sink add/remove events.
#
# Naming/topology methodology mirrors music-assistant local_audio's
# remap_topology.py:
#   - card-name normalization with connector-label and hardware-tag
#     disambiguation (normalize_card_name / connector_label)
#   - one stereo zone sink per recognized channel pair present in the
#     master's channel map (front/rear/side stereo, center+sub)
#   - one full-passthrough "multichannel_stereo" sink for masters with
#     6+ channels
#   - masters with <=2 channels are left alone entirely — no remap sink
#     is created for them (this is a behavior CHANGE from the previous
#     version of this script, which created a renamed passthrough remap
#     for 2-channel HDMI/S-PDIF sinks; remap_topology.py does not do
#     this, so it's dropped here to match).
#
# NOTE: introducing the connector-label/hardware-tag suffixes changes the
# sink names this script produces (e.g. "HD_Audio_Generic_front_stereo"
# may become "HD_Audio_Generic_hdmi_a3f9_front_stereo" once a second,
# previously-unambiguous card is present). Any player/zone config that
# references the OLD sink names by name will need to be repointed at the
# new names after this script runs for the first time. Test on a
# non-production sink-name set before relying on this.
set +e

LOG="/config/local_pulse_audio_stereo_pairs/remap_modules.log"
mkdir -p "$(dirname "$LOG")"

log() { echo "$(date) — $*" >> "$LOG"; }

# ---------------------------------------------------------------------------
# Wait for PulseAudio
# ---------------------------------------------------------------------------
wait_for_pulse() {
    for i in $(seq 1 30); do
        pactl info >/dev/null 2>&1 && return 0
        log "Waiting for PulseAudio... ($i)"
        sleep 1
    done
    log "ERROR: PulseAudio not available after 30s"
    return 1
}

# ---------------------------------------------------------------------------
# Normalize an alsa.card_name into a sink-name prefix, then append an
# optional connector label and hardware tag for disambiguation.
# Mirrors remap_topology.normalize_card_name().
# ---------------------------------------------------------------------------
normalize_card_name() {
    local raw="$1" label="$2" tag="$3"
    local name
    name=$(echo "$raw" | tr ' -' '_' | tr -cd '[:alnum:]_')
    [[ -n "$label" ]] && name="${name}_${label}"
    [[ -n "$tag" ]] && name="${name}_${tag}"
    echo "$name"
}

# ---------------------------------------------------------------------------
# Derive a short connector-type label ("hdmi", "spdif", "analog", or the
# lowercased device.bus value). Mirrors remap_topology.connector_label().
# Distinguishes e.g. an HDMI function and an analog function on the same
# physical chip that would otherwise share an identical alsa.card_name.
# ---------------------------------------------------------------------------
connector_label() {
    local sink_name_lower="$1" device_bus="$2"
    if [[ "$sink_name_lower" == *hdmi* ]]; then
        echo "hdmi"
    elif [[ "$sink_name_lower" == *iec958* || "$sink_name_lower" == *spdif* ]]; then
        echo "spdif"
    elif [[ "$device_bus" == "pci" ]]; then
        echo "analog"
    elif [[ -n "$device_bus" ]]; then
        echo "$device_bus" | tr '[:upper:]' '[:lower:]'
    fi
}

# ---------------------------------------------------------------------------
# Derive a short, stable hardware tag from the sink's bus path so identical
# cards get distinct sink-name prefixes. Bus-path derived (not ALSA card
# index) so it survives reboots regardless of enumeration order. Applied
# unconditionally to every multi-channel master processed below (not just
# on detected collision) so a card's sink-name prefix never changes later
# purely because a second identical card was added.
#
# ASSUMPTION: uses the "device.bus_path" PA property as the hash source.
# Confirm this property is actually present in `pactl list sinks` output
# for your cards before relying on this — some drivers/backends may only
# expose "sysfs.path" or nothing bus-path-like at all, in which case this
# falls back to the sink name itself (stable, but not survivorship-tested
# against ALSA card-index churn the way a true bus path would be).
# ---------------------------------------------------------------------------
hardware_tag() {
    local bus_path="$1" fallback="$2"
    local source="${bus_path:-$fallback}"
    [[ -z "$source" ]] && return
    echo -n "$source" | md5sum | cut -c1-4
}

# ---------------------------------------------------------------------------
# Create zone remap sinks for all current physical PA sinks with more than
# 2 channels:
#   - one stereo zone per recognized channel pair present in the master's
#     channel map
#   - one full-passthrough "multichannel_stereo" sink (same channel count
#     and map as the master) for masters with 6+ channels
# Masters with <=2 channels are skipped entirely (matches
# remap_topology.compute_remap_topology(), which returns [] for them).
# Skips sinks that are already remap sinks and skips zones that already
# exist. Does NOT unload existing remaps — call cleanup_all_remaps first
# if needed.
# ---------------------------------------------------------------------------
create_pairs() {
    log "Creating remap-sink topology..."

    declare -A stereo_pairs=(
        ["front_stereo"]="front-left front-right"
        ["rear_stereo"]="rear-left rear-right"
        ["side_stereo"]="side-left side-right"
        ["center_sub"]="front-center lfe"
    )
    local surround_passthrough_min_channels=6

    full_sink_list=$(pactl list sinks)
    current_sinks_short=$(pactl list sinks short)

    # Name + alsa.card_name pairing — same proven technique as before,
    # unchanged (assumes each sink block has exactly one alsa.card_name
    # property, in Name-then-property order across the whole listing).
    sinks=$(echo "$full_sink_list" | grep -E 'Name:|alsa.card_name' | sed -n '
        s/.*Name: //p
        s/.*alsa.card_name = "\(.*\)"/\1/p
    ' | paste - -)

    while read -r sink card_name_raw; do
        [[ -z "$sink" ]] && continue
        [[ -z "$card_name_raw" ]] && card_name_raw=$(basename "$sink")

        # Per-sink lookups, each independently anchored on this sink's own
        # "Name:" line (same forward-scan-from-Name pattern the old script
        # already used for Driver — safe even if a property is missing or
        # out of order for a particular sink).
        driver=$(echo "$full_sink_list" | awk -v target="$sink" '
            /^[[:space:]]*Name: / {
                current = $0; sub(/^[[:space:]]*Name: /, "", current)
                found = (current == target); next
            }
            found && /Driver:/ { print $2; exit }
        ')
        [[ "$driver" == "module-remap-sink.c" ]] && continue

        channel_map=$(echo "$full_sink_list" | awk -v target="$sink" '
            /^[[:space:]]*Name: / {
                current_sink = $0
                sub(/^[[:space:]]*Name: /, "", current_sink)
                found = (current_sink == target)
                next
            }
            found && /^[[:space:]]*Channel Map:/ {
                channel_map = $0
                sub(/^[[:space:]]*Channel Map: /, "", channel_map)
            }
            found && /^Sink #/ && NR > 1 { exit }
            END { print channel_map }
        ')
        [[ -z "$channel_map" ]] && continue

        device_bus=$(echo "$full_sink_list" | awk -v target="$sink" '
            /^[[:space:]]*Name: / {
                current = $0; sub(/^[[:space:]]*Name: /, "", current)
                found = (current == target); next
            }
            found && /device\.bus = / {
                match($0, /device\.bus = "[^"]*"/)
                val = substr($0, RSTART, RLENGTH)
                gsub(/device\.bus = "|"/, "", val)
                print val
                exit
            }
        ')

        bus_path=$(echo "$full_sink_list" | awk -v target="$sink" '
            /^[[:space:]]*Name: / {
                current = $0; sub(/^[[:space:]]*Name: /, "", current)
                found = (current == target); next
            }
            found && /device\.bus_path = / {
                match($0, /device\.bus_path = "[^"]*"/)
                val = substr($0, RSTART, RLENGTH)
                gsub(/device\.bus_path = "|"/, "", val)
                print val
                exit
            }
        ')

        channels=$(echo "$channel_map" | awk -F',' '{print NF}')

        # <=2 channel masters: skip entirely, matching
        # remap_topology.compute_remap_topology()'s behavior for these.
        if [[ "$channels" -le 2 ]]; then
            continue
        fi

        sink_lower=$(echo "$sink" | tr '[:upper:]' '[:lower:]')
        label=$(connector_label "$sink_lower" "$device_bus")
        tag=$(hardware_tag "$bus_path" "$sink")
        card=$(normalize_card_name "$card_name_raw" "$label" "$tag")

        # One zone per recognized channel pair present in the master.
        for suffix in "${!stereo_pairs[@]}"; do
            required=(${stereo_pairs[$suffix]})
            if [[ "$channel_map" == *"${required[0]}"* && "$channel_map" == *"${required[1]}"* ]]; then
                remap_name="${card}_${suffix}"
                echo "$current_sinks_short" | grep -q "[[:space:]]${remap_name}[[:space:]]" && continue
                log "Creating $remap_name from $sink"
                module_id=$(pactl load-module module-remap-sink \
                    sink_name="$remap_name" master="$sink" \
                    sink_properties="device.description=$remap_name" \
                    channels=2 master_channel_map="${required[0]},${required[1]}" \
                    channel_map="${required[0]},${required[1]}" remix=no 2>>"$LOG")
                [[ "$module_id" =~ ^[0-9]+$ ]] \
                    && log "Loaded module $module_id for $remap_name" \
                    || log "Failed to load $remap_name"
            fi
        done

        # Full-passthrough "multichannel_stereo" sink for 6+ channel
        # masters — same channel count/map as the master, independent
        # hardware volume control.
        if [[ "$channels" -ge "$surround_passthrough_min_channels" ]]; then
            remap_name="${card}_multichannel_stereo"
            if ! echo "$current_sinks_short" | grep -q "[[:space:]]${remap_name}[[:space:]]"; then
                log "Creating $remap_name from $sink (full passthrough, ${channels}ch)"
                module_id=$(pactl load-module module-remap-sink \
                    sink_name="$remap_name" master="$sink" \
                    sink_properties="device.description=$remap_name" \
                    channels="$channels" master_channel_map="$channel_map" \
                    channel_map="$channel_map" remix=no 2>>"$LOG")
                [[ "$module_id" =~ ^[0-9]+$ ]] \
                    && log "Loaded module $module_id for $remap_name" \
                    || log "Failed to load $remap_name"
            fi
        fi

    done <<< "$sinks"

    log "Remap-sink topology pass complete"
}

# ---------------------------------------------------------------------------
# Remove remap sinks whose master sink no longer exists
# ---------------------------------------------------------------------------
cleanup_orphaned_remaps() {
    log "Checking for orphaned remap sinks..."
    current_sinks=$(pactl list sinks short | awk '{print $2}')
    pactl list short modules | awk '/module-remap-sink/ {print $1}' | while read -r mod_id; do
        master=$(pactl list modules | awk -v id="$mod_id" '
            /^Module #/ { current = $2 }
            current == id && /master=/ {
                match($0, /master=[^ \t]+/)
                print substr($0, RSTART+7, RLENGTH-7)
                exit
            }
        ')
        if [[ -n "$master" ]] && ! echo "$current_sinks" | grep -q "^${master}$"; then
            log "Unloading orphaned remap module $mod_id (master=$master gone)"
            pactl unload-module "$mod_id"
        fi
    done
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
wait_for_pulse || exit 1

# One-time setup on startup
pactl unload-module module-suspend-on-idle 2>/dev/null || true
for id in $(pactl list short modules | awk '/module-remap-sink/ {print $1}'); do
    log "Unloading existing remap module $id"
    pactl unload-module "$id"
done

create_pairs

# Watch for physical sink changes only — ignore remap sink events by
# filtering out events that correspond to module-remap-sink sinks.
log "Watching for PulseAudio sink events..."
pactl subscribe 2>>"$LOG" | grep -E "on sink" | while read -r event; do
    # Extract sink index from event line e.g. "Event 'new' on sink #5"
    sink_index=$(echo "$event" | grep -o '#[0-9]*' | tr -d '#')
    if [[ -n "$sink_index" ]]; then
        driver=$(pactl list sinks 2>/dev/null | awk -v idx="$sink_index" '
            /^Sink #/ { found = ($2 == "#"idx) }
            found && /Driver:/ { print $2; exit }
        ')
        # Ignore events from remap sinks to avoid feedback loop
        [[ "$driver" == "module-remap-sink.c" ]] && continue
    fi

    log "PA event: $event"
    sleep 1  # let PA settle
    if [[ "$event" == *"'new'"* ]]; then
        create_pairs
    elif [[ "$event" == *"'remove'"* ]]; then
        cleanup_orphaned_remaps
    fi
done

log "pactl subscribe exited, restarting service..."
exit 1
