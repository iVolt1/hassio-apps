+// Senders such as Music Assistant's cliairplay send SSRC 0 on every buffered packet.
+// Map the audioFormat announced in the stream SETUP to an equivalent SSRC.
+// Values per https://emanuelecozzi.net/docs/airplay2/audio/
+ssrc_t ssrc_from_audio_format(uint64_t audio_format) {
+  switch (audio_format) {
+  case 0x40000:
+    return ALAC_44100_S16_2;
+  case 0x80000:
+    return ALAC_44100_S24_2;
+  case 0x200000:
+    return ALAC_48000_S24_2;
+  default:
+    return SSRC_NONE;
+  }
+}
